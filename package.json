{
  "name": "livevoxnative",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:build": "cd android && ./gradlew assembleRelease",
    "ios": "expo run:ios",
    "ios:build": "cd ios && xcodebuild -workspace LiveVoxNative.xcworkspace -scheme LiveVoxNative -configuration Release",
    "macos": "react-native run-macos",
    "tvos": "react-native run-tvos",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:ios": "expo prebuild --platform ios",
    "prebuild:clean": "expo prebuild --clean"
  },
  "dependencies": {
    "expo": "~54.0.32",
    "expo-audio-engine": "file:./modules/audio-engine",
    "expo-dev-client": "~6.0.7",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "^15.15.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
